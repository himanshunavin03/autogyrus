APP_ENV=production
MYSQL_DSN=mysql+pymysql://search_reader:change-me@mysql:3306/autogyrus
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=autogyrus_vehicles_v1
PUBLIC_API_KEY=replace-with-independent-long-random-token
ADMIN_API_KEY=replace-with-different-long-random-token
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
REQUEST_TIMEOUT_SECONDS=12
MAX_REQUEST_BYTES=8192
